{
  "name": "ratchet",
  "version": "0.1.0",
  "description": "Your agent writes the bug once, and once only. Kane catches it in a browser; Ratchet locks it as a deterministic check.",
  "type": "module",
  "bin": { "ratchet": "bin/ratchet.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "app": "node demo-app/server.js",
    "verify": "node bin/ratchet.js verify",
    "check": "node bin/ratchet.js check",
    "prove": "node bin/ratchet.js prove",
    "status": "node bin/ratchet.js status",
    "lint": "eslint demo-app",
    "test": "node --test test/",
    "plant:dropped-field": "git apply demo-app/bugs/dropped-field.patch",
    "plant:fake-disabled": "git apply demo-app/bugs/fake-disabled.patch",
    "setup": "npm install && npm install -g @testmuai/kane-cli@0.10.4 && kane-cli login"
  },
  "devDependencies": {
    "eslint": "9.39.5"
  }
}
